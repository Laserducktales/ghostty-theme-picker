Output demo.gif

Set Theme "Catppuccin Mocha"
Set Shell "bash"
Set FontSize 15
Set Width 1000
Set Height 600
Set Padding 20
Set Framerate 24

# Launch the picker silently so the GIF starts with fzf open
Hide
Type "PATH=/Applications/Ghostty.app/Contents/MacOS:/opt/homebrew/bin:$PATH /Users/long/projects/ghostty-theme-picker/ghostty-theme-picker"
Enter
Sleep 3s
Show

# Scroll up through some themes
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms
Up
Sleep 400ms

Sleep 600ms

# Type to search
Type "Raycast Dark"
Sleep 1s
Down
Sleep 400ms
Down
Sleep 400ms
Down
Sleep 400ms

Sleep 800ms
Enter
Sleep 1s
